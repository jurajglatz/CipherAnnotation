# Copy to .env (which is gitignored) and fill in real values.

# --- Postgres ---
POSTGRES_DB=cipher_annotation
POSTGRES_USER=cipher
POSTGRES_PASSWORD=change-me-strong-password

# --- API ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Google OAuth (leave blank if not using google-login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend / public URL ---
# Host port that the web (nginx) container is published on.
WEB_PORT=8080
# Public origin used for CORS (must match what the browser sees).
PUBLIC_ORIGIN=http://localhost:8080
